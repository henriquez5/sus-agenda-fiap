{
  "info": {
    "name": "SUS Agenda — fluxo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute em ordem. Para gravar com pausas, inicie a API com OFFER_TTL=PT15M. Dados fictícios."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "operador"
    },
    {
      "key": "password",
      "value": "operador-demo"
    }
  ],
  "item": [
    {
      "name": "Cadastrar Ana Fictícia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/patients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Fictícia\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ana\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cadastrar Bruno Fictício",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/patients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bruno Fictício\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"bruno\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cadastrar Carla Fictícia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/patients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Carla Fictícia\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"carla\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar agenda",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/agendas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unitName\": \"UBS Demo {{$timestamp}}\",\n  \"specialty\": \"Clínica geral\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"agenda\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar horário amanhã",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/agendas/{{agenda}}/slots",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startsAt\": \"{{startsAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"slot\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"startsAt\", new Date(Date.now()+86400000).toISOString());"
            ]
          }
        }
      ]
    },
    {
      "name": "Agendar Ana",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/slots/{{slot}}/book",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{ana}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"appointmentAna\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Colocar bruno na fila",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/agendas/{{agenda}}/waitlist",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{bruno}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Colocar carla na fila",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/agendas/{{agenda}}/waitlist",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{carla}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancelar Ana",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/appointments/{{appointmentAna}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar oferta para Bruno",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/agendas/{{agenda}}/offers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const offer=pm.response.json().find(o=>o.status===\"PENDING\");",
              "pm.test(\"Bruno é o próximo\",()=>pm.expect(offer.patientId).to.eql(pm.collectionVariables.get(\"bruno\")));",
              "pm.collectionVariables.set(\"offerBruno\",offer.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Vaga reservada rejeita Carla",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/slots/{{slot}}/book",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": \"{{carla}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bruno aceita",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/offers/{{offerBruno}}/accept"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"appointmentBruno\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
