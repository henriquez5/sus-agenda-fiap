          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const offer=pm.response.json().find(o=>o.status===\"PENDING\");",
              "pm.test(\"Carla é a próxima\",()=>pm.expect(offer.patientId).to.eql(pm.collectionVariables.get(\"carla\")));",
              "pm.collectionVariables.set(\"offerCarla\",offer.id);"
            ]
          }
        }
      ]
    },
