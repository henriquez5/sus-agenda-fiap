            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bruno continua agendado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/patients/{{bruno}}/appointments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Confirmado\",()=>pm.expect(pm.response.json()[0].status).to.eql(\"CONFIRMED\"));"
            ]
          }
        }
      ]
    },
